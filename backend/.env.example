SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
DATABASE_URL=sqlite:///./nexwealth.db
FRONTEND_ORIGIN=http://localhost:5173

# Optional password-reset and notification email delivery (SMTP)
# For Gmail, use smtp.gmail.com:587, a Google App Password, and your sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional hosted AI assistant (keep this key private)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
